# Copia este archivo a `mobile/.env` y reinicia `npx expo start`.
# Nunca subas `.env` al repositorio.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Opcional: restringe login solo a estos correos (máx. 4, separados por coma).
# Déjalo vacío para permitir cualquier usuario creado en Supabase Auth.
EXPO_PUBLIC_ALLOWED_EMAILS=

# Concepto de tamaño familiar (solo informativo en UI; default 4)
EXPO_PUBLIC_FAMILY_USER_SLOTS=4
